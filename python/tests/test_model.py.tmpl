"""Headless tests of the TUI standard (same checks as the Go template)."""

import pytest
from rich.text import Text

from {{PROJECT_NAME}} import config as cfgmod
from {{PROJECT_NAME}}.model import Model
from {{PROJECT_NAME}}.standard import INDENT


@pytest.fixture
def m(tmp_path, monkeypatch):
    monkeypatch.setenv("HOME", str(tmp_path))
    monkeypatch.delenv("XDG_DATA_HOME", raising=False)
    monkeypatch.delenv("XDG_STATE_HOME", raising=False)
    model = Model()
    model.width = 100
    model.items = ["alpha", "bravo", "charlie"]
    return model


def plain(s):
    return Text.from_markup(s).plain


def press(m, *keys):
    for k in keys:
        m.key(k)
    return m


def test_text_indented_one_rule(m):
    views = {"home": m.view()}
    press(m, "down", "down", "o")
    views["config"] = m.view()
    press(m, "escape", "down", "down", "h")
    views["help"] = m.view()
    for name, v in views.items():
        rules = 0
        for line in plain(v).split("\n"):
            if line.startswith("·"):
                rules += 1
            elif line:
                assert line.startswith("  "), f"{name}: {line!r}"
        assert rules == 1, name


def test_menu_line_and_navigation(m):
    v = plain(m.view())
    assert "Delete x · Config o · Log l · Quit q · Help h" in v and "▶ Delete" not in v
    press(m, "tab")
    assert m.menu_active and "▶ Delete" in plain(m.view())
    press(m, "right", "right")
    assert m.btn == 2
    press(m, "tab")
    assert not m.menu_active and m.focus == 0


def test_q_and_esc_symmetric(m):
    press(m, "q")
    assert m.new_text == "q" and not m.quit  # q types inside a field
    press(m, "escape")
    assert m.quit


def test_help_returns_and_global_shortcuts(m):
    press(m, "down", "down", "o", "tab", "h")
    assert m.state == "help"
    press(m, "q")
    assert m.state == "config"
    press(m, "ctrl+u")
    assert m.state == "confirm" and m.btn == 1  # No preselected
    press(m, "n")
    assert m.state == "config"


def test_theme_reset_saved_outside_config(m):
    m.cfg["COLOR_HEADER"] = "red"
    press(m, "ctrl+t")
    assert m.cfg["COLOR_HEADER"] == "ocean"
    assert 'COLOR_HEADER="ocean"' in cfgmod.config_path().read_text()


def test_every_field_in_config_file(m):
    cfg = cfgmod.defaults()
    cfg["COLOR_TEXT"] = "cyan"
    cfgmod.save_fresh(cfg)
    text = cfgmod.config_path().read_text()
    for k, _d, _desc, _sec, o in cfgmod.FIELDS:
        if cfgmod.on_this_os(o):
            assert f'\n{k}="' in text, k
    got, found = cfgmod.load()
    assert found and got["COLOR_TEXT"] == "cyan"


def test_config_scrolls_to_fit(m):
    m.height = 30
    press(m, "down", "down", "o", *["down"] * 12)
    v = plain(m.view())
    assert v.count("\n") <= m.height and "▶" in v


def test_add_and_delete(m):
    m.cfg["CONFIRM_DELETE"] = "false"
    press(m, "z", "e", "d", "enter")
    assert len(m.items) == 4
    press(m, "down", "down", "x")
    assert m.items[0] == "bravo"


def test_no_line_wider_than_terminal(m):
    m.width = 60
    for v in (m.view(), press(m, "down", "down", "o").view()):
        for line in plain(v).split("\n"):
            assert len(line) <= 60, line


def test_alias_row_shows_where_once(m, tmp_path):
    (tmp_path / ".zshrc").write_text("alias {{PROJECT_NAME}}='/x'\n")
    press(m, "down", "down", "o")
    line = [l for l in plain(m.view()).split("\n") if "alias {{PROJECT_NAME}}:" in l][0]
    assert line.count("~/.zshrc:1") == 1 and "installed —" in line


def test_banner_font_and_live_info(m):
    press(m, "down", "down", "o")
    for _ in range(30):
        if m.form.rows[m.form.focus].get("key") == "BANNER_FONT":
            break
        press(m, "down")
    press(m, "right", "right")
    assert "▀" in plain(m.view())
    press(m, "escape")
    from {{PROJECT_NAME}}.standard import Theme
    m.cfg["LIVE_INFO"] = "off"
    Theme.apply(m.cfg)
    assert "\U000F0279" not in plain(m.view()).split("› Home")[0]
    m.cfg["LIVE_INFO"] = "full"
    Theme.apply(m.cfg)
    live = plain(m.live())
    assert "\U000F0279 3" in live and "items" not in live
    m.items = []
    assert m.live() == ""


# §17: Help generated from the menus, Banner sub-heading + text, Doctor, lowercase
# config menu, Clear, bold selection.
def test_help_from_menus_and_doctor(m):
    press(m, "down", "down", "h")  # leave the text fields first
    v = plain(m.view())
    for bad in ("Other screens", "Navigation", "Everywhere", "h, ?, F1", "Ctrl+S"):
        assert bad not in v
    for want in ("Shortcuts", "Doctor (Config)", "^s", "^d", "Refresh", "Clear (Log)", "Commands", "Aliases", "Integrations"):
        assert want in v
    assert v.index("Aliases") > v.index("Commands")
    press(m, "escape", "down", "down", "o", "ctrl+d")
    assert m.state == "doctor" and any("config" in l for l in m.doctor_lines)
    assert "Checks" in plain(m.view())
    press(m, "escape")
    assert m.state == "config" and m.form is not None


def test_config_banner_subheading_and_log_clear(m):
    press(m, "down", "down", "o")
    v = plain(m.view())
    for want in ("Save ^s", "Doctor ^d", "Help h", "\n" + INDENT + "  Banner\n", "Text:", "Font:", "Run doctor"):
        assert want in v, want
    assert "\n" + INDENT + "Banner\n" not in v and "^S" not in v and "F1" not in v
    for r in m.form.rows:
        if r.get("key") == "BANNER_TEXT":
            r["value"] = "HELLO"
    cfg = m.form.to_config()
    assert cfg["BANNER_TEXT"] == "HELLO"
    from {{PROJECT_NAME}}.standard import Theme, banner
    Theme.apply(cfg)
    assert "█" in plain(banner())
    m.form.reset_theme()
    assert m.form.to_config()["BANNER_TEXT"] == ""
    press(m, "escape", "down", "down", "l")
    lv = plain(m.view())
    assert "Clear c" in lv and "Clear log" not in lv


def test_menu_glitter(m):
    """Selected entry: a glint sweeps across the label (frame-dependent), never a
    bold/recoloured whole label; MENU_EFFECT=none leaves it plain."""
    from {{PROJECT_NAME}}.standard import Theme
    press(m, "tab")
    assert m.menu_has_focus()
    Theme.frame = 0
    off = m.view()[m.view().index("▶ [/]"):]
    Theme.frame = 2
    on = m.view()[m.view().index("▶ [/]"):]
    assert off != on and "[bold" in on[5:60]
    assert "[bold" not in off[5:40]
    m.cfg["MENU_EFFECT"] = "none"
    Theme.apply(m.cfg)
    v = m.view()[m.view().index("▶ [/]"):]
    assert "[bold" not in v[5:40]
    Theme.frame = 0
    Theme.apply(m.cfg | {"MENU_EFFECT": "glitter"})
